# Database
DATABASE_URL="postgresql://localhost:5432/polymarket_copytrade"

# Polling Intervals (milliseconds)
LEADERBOARD_SCAN_INTERVAL_MS=43200000    # 12 hours
BACKFILL_POLL_INTERVAL_MS=60000           # 1 minute
SCORE_RECALC_INTERVAL_MS=21600000         # 6 hours
TRADE_MONITOR_INTERVAL_MS=120000          # 2 minutes

# Proxy Configuration
PROXY_ENABLED=false
PROXY_LIST=""                              # comma-separated, e.g. socks5://host:port,http://user:pass@host:port

# API Base URLs
DATA_API_BASE_URL=https://data-api.polymarket.com
GAMMA_API_BASE_URL=https://gamma-api.polymarket.com

# Leaderboard Discovery
LEADERBOARD_CATEGORIES=OVERALL,POLITICS,SPORTS,CRYPTO,CULTURE
LEADERBOARD_TIME_PERIODS=WEEK,MONTH,ALL
LEADERBOARD_LIMIT=50

# Pre-Screening Thresholds
PRESCREEN_MIN_PNL=0                        # Minimum leaderboard PnL (0 = exclude negative PnL)
PRESCREEN_MIN_VOLUME=1000                  # Minimum leaderboard volume in USDC
PRESCREEN_MIN_POSITIONS=10                 # Minimum position count
PRESCREEN_MIN_WIN_RATE=0.45                # Minimum win rate (0.45 = 45%)
PRESCREEN_CONCURRENCY=10                   # Concurrent pre-screen API requests

# WebSocket (real-time trade detection)
WS_ENABLED=false
WS_RECONNECT_MAX_MS=30000
WS_FALLBACK_POLL_MS=300000               # 5 minutes
LIVE_TRADERS_POLL_MS=500                 # Rapid-poll interval for live-allocation traders (primary signal source; 150ms on AWS, 500ms on Finland)
RAPID_POLL_LIMIT=20                      # API limit per wallet per rapid-poll cycle
CHAIN_WATCHER_ENABLED=false              # Polygon blockchain event detection (~2-3s latency); enable after testing
SKIP_CHAIN_MAKER_FILLS=true              # Skip chain-detected trades where trader was passive maker (resting limit order filled by someone else)
POLYGON_WS_RPC_URL=wss://polygon-bor-rpc.publicnode.com  # Polygon WS RPC for CTF Exchange OrderFilled events
POLYGON_HTTP_RPC_URL=https://polygon-bor-rpc.publicnode.com  # Polygon HTTP RPC for eth_getLogs verification
POLYGON_WS_RPC_URL_B=wss://polygon-bor-rpc.publicnode.com  # Backup WSS provider for dual-WSS instance B (use different provider for independent failure domain)
POLYGON_HTTP_RPC_URL_B=https://polygon-bor-rpc.publicnode.com  # Backup HTTP RPC for dual-WSS instance B
CHAIN_VERIFY_INTERVAL_MS=60000            # Periodic eth_getLogs verification (60s; was 5 min)
CHAIN_EVENT_STALE_MS=90000                # Force reconnect if no WSS events for 90s despite healthy connection
CHAIN_HEARTBEAT_MS=10000                  # WSS keepalive interval (10s; was hardcoded 45s)
CHAIN_STALE_MS=25000                      # WSS stale threshold — force reconnect (25s; was hardcoded 135s)
CHAIN_DUAL_WSS=true                       # Two independent WSS connections for zero-gap coverage

# Copy-Trade Wallet Credentials (required when COPY_TRADE_ENABLED=true)
PRIVATE_KEY=
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
FUNDER_ADDRESS=
SIGNATURE_TYPE=2                          # 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE

# Copy-Trade Risk Controls
COPY_TRADE_ENABLED=false
MAX_POSITION_USD=2                        # Absolute per-trade cap (USD)
MAX_PREDICTION_POSITION_USD=4             # Max net USD per prediction per allocation (0 = disabled)
MAX_DAILY_LOSS_USD=200                    # Global daily BUY spend backstop (USD)
MAX_TRADE_PERCENT=0.50                    # Max % of allocation per trade (0.50 = 50%)
PORTFOLIO_VALUE_REFRESH_MS=300000         # Trader portfolio value refresh interval (5 min)
SLIPPAGE_UPSIDE_FRACTION=0.05             # BUY limit = P + max((1-P)*fraction, absolute_min); sacrifices 5% of upside for execution certainty
SLIPPAGE_MIN_ABSOLUTE=0.01               # 1¢ absolute minimum slippage tolerance (floor for high-priced markets)
COPY_TRADE_PERCENT=0.10                   # Copy 10% of trader's actual trade size
MIN_COMPOSITE_SCORE=0                     # Skip BUY trades with composite score below this (0 = disabled, follow all)
MIN_SIGNAL_TRADE_USD=0                    # Skip BUY trades where trader's own USD < this (0 = disabled)

# Anti-Cycle Guard
TOKEN_SELL_COOLDOWN_MS=60000              # Per-token cool-down after SELL fill to prevent market-making spread loss (0 = disabled)

# Majority Side Accumulator (opt-in per allocation via majorityOnlyMode)
MAJORITY_MIN_TRADES=10                   # LEGACY: count-based gate (kept for compat, unused when MAJORITY_MIN_USD > 0)
MAJORITY_MIN_USD=200                     # Min USD volume across trader BUYs before majority detection (0-10000)
MAJORITY_MIN_RATIO=0.50                  # Min fraction of BUYs on one side to confirm majority (0.50-0.95)
MAJORITY_PRUNE_AGE_MS=90000000           # Prune accumulator entries older than this (90000000 = 25h)

# Midpoint WS Cache (eliminates REST getMidpoint() in stale-signal guard)
MIDPOINT_CACHE_ENABLED=true               # WS-backed midpoint cache for BUY stale-signal check (false = always use REST API)
MIDPOINT_CACHE_MAX_AGE_MS=5000            # Cache TTL — entries older than this fall back to REST API
MIDPOINT_CACHE_PRUNE_MS=600000            # Unsubscribe tokens not seen in drain loop for this long (600000 = 10 min)

# Pipeline Optimization
POSITION_CACHE_ENABLED=true               # Cache positions in bulk SQL for faster drain cycles
PARALLEL_DRAIN_ENABLED=true               # Parallel drain pipeline: phaseA under per-allocation mutex, pLimit(10) CLOB, batch settle (requires POSITION_CACHE_ENABLED=true)

# Order Aggregation Pool
POOL_MIN_AMOUNT_USD=0.50                  # Min USD to pool paper trades
LIVE_POOL_MIN_AMOUNT_USD=1.00             # Min USD to fire live pool (must meet CLOB $1 minimum)
POOL_BURN_TIMEOUT_MS=180000               # Per-entry FIFO burn window (180000 = 3 min)

# Auto-Claim (on-chain redemption of winning conditional tokens)
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com  # Polygon JSON-RPC endpoint for CTF redeemPositions()
AUTO_CLAIM_ENABLED=false                  # Set true AFTER verifying ProxyWalletFactory on Polygonscan
MIN_CLAIM_USD=1                           # Skip auto-claim for wins below this USD value (saves gas)

# Position Settlement
SETTLEMENT_SWEEP_INTERVAL_MS=300000       # Check for resolved markets interval (5 min)
STALE_TRADE_CUTOFF_MS=600000             # Ignore detected trades older than this (10 min)
SETTLEMENT_ONCHAIN_FALLBACK_ENABLED=true # On-chain CTF resolution check for markets past endDate (Gamma API lag fallback)
SETTLEMENT_ENDDATE_GRACE_MS=86400000     # Grace period after endDate before on-chain check (24h; sports endDate = game start)

# CLOB Reconciliation & Balance Check
BALANCE_CHECK_INTERVAL_MS=600000         # Wallet balance check interval (10 min)
BALANCE_MISMATCH_THRESHOLD=5             # Warn if CLOB wallet vs DB capital differs by >$5

# Phantom Position Cleanup (auto-sell dust positions from rounding)
PHANTOM_AUTO_CLEANUP_ENABLED=false      # Auto-cleanup phantom dust positions
PHANTOM_AUTO_CLEANUP_MAX_COST_USD=10    # Max cost to sell phantom positions

# Allocation Circuit Breaker (pause allocation on loss streak)
ALLOCATION_CIRCUIT_BREAKER_ENABLED=false
ALLOCATION_CIRCUIT_BREAKER_THRESHOLD=0.30  # Pause if loss exceeds this fraction of capital

# Pre-Resolution Auto-Sell (sell positions before market closes to recover USDC)
PRE_RESOLUTION_SELL_ENABLED=false        # Enable auto-selling before market resolution
PRE_RESOLUTION_SELL_WINDOW_MS=3600000    # Sell window before market end (1 hour)

# Paper Trade Fee Simulation (most markets = 0 fees)
# Sports (NCAAB, Serie A): FEE_RATE=0.0175, FEE_EXPONENT=1
# Crypto (5/15-min):       FEE_RATE=0.25,   FEE_EXPONENT=2
PAPER_TRADE_FEE_RATE=0
PAPER_TRADE_FEE_EXPONENT=1

# Data Retention
DATA_RETENTION_DAYS=90

# Logging
LOG_LEVEL=info

# Arb Scoring Filter (exclude high-price BUY trades from trader scoring)
ARB_FILTER_PRICE=0.98                     # BUY trades at >= this price excluded from scoring

# ─── Arb Worker (BTC Up/Down Last-Minute Strategy) ───
ARB_ENABLED=false
ARB_IS_PAPER=true                         # Paper trade mode (default safe)
ARB_ASSETS=btc                            # Comma-separated: btc,eth,sol,xrp
ARB_MARKET_TYPES=5m                       # Comma-separated: 5m,15m,1h,4h

# Arb Capital (separate budget from copy-trade, per-strategy)
ARB_INITIAL_CAPITAL_USD=1000              # Global default starting budget
#ARB_STANDARD_INITIAL_CAPITAL_USD=1000    # Override for standard strategy (falls back to ARB_INITIAL_CAPITAL_USD)
ARB_CONTRARIAN_INITIAL_CAPITAL_USD=200    # Starting budget for contrarian strategy
ARB_POSITION_SIZE_USD=500                 # USD per cycle (standard)
ARB_MAX_DAILY_LOSS_USD=500                # Aggregate daily loss circuit breaker (global across strategies)

# Arb Strategy
ARB_MAX_ENTRY_PRICE=0.99                  # Max price to pay per share
ARB_MIN_PRICE_CHANGE=0.0001              # 0.01% min BTC move (FLAT floor)
ARB_MAX_CONSECUTIVE_LOSSES=5              # Consecutive loss circuit breaker

# Arb Confidence Scoring
ARB_MIN_CONFIDENCE=0.60                   # 0-1: minimum score to enter (0.60 filters coin flips, 0 disables)
ARB_CONFIDENCE_PRICE_SCALE=0.002          # Sigmoid scale for price move magnitude
ARB_CONFIDENCE_VOL_SCALE=0.0003           # Exp decay scale for volatility penalty
ARB_SNAP_BUFFER_SIZE=300                  # 1-sec snapshot buffer (per feed, 300 = 5 min)

# Arb Stop-Loss (sell early when position is losing)
ARB_STOP_LOSS_ENABLED=true              # Enable automatic stop-loss for arb positions
ARB_STOP_LOSS_PRICE=0.50                # Sell if outcome price drops below this (0.50 = recover ~50%)

# Arb Contrarian Mode (buy opposite outcome at low price — best on 15m markets)
ARB_CONTRARIAN_ENABLED=false            # Buy losing-side token instead of winning-side
ARB_CONTRARIAN_EVERY3_ENABLED=false     # Contrarian variant: only enter every 3rd candle
ARB_CONTRARIAN_ANTIMART_ENABLED=false   # Contrarian variant: halve position size after a loss
ARB_CONTRARIAN_COOLDOWN_ENABLED=false   # Contrarian variant: skip 2 candles after 3 consecutive losses
ARB_CONTRARIAN_MAX_PRICE=0.10           # Max entry price for contrarian token
ARB_CONTRARIAN_POSITION_SIZE_USD=10     # Smaller size (many small bets)

# Arb Settlement (background non-blocking sweep)
ARB_SETTLEMENT_SWEEP_INTERVAL_MS=10000   # Background settlement check interval
ARB_SETTLEMENT_TIMEOUT_MS=600000         # Max wait for market resolution (10 min)

# Arb Fees (Polymarket crypto formula: shares × rate × (p × (1-p))^exp)
ARB_FEE_RATE=0.25
ARB_FEE_EXPONENT=2

# Arb Wallet (optional — if unset, shares copy-trade wallet)
# Set these to use a separate Polymarket account for arb
#ARB_PRIVATE_KEY=
#ARB_CLOB_API_KEY=
#ARB_CLOB_API_SECRET=
#ARB_CLOB_API_PASSPHRASE=
#ARB_FUNDER_ADDRESS=
#ARB_SIGNATURE_TYPE=2

# ─── Scalp Worker (Esports Bot Detection Strategy) ───
SCALP_ENABLED=false
SCALP_IS_PAPER=true                     # Paper trade mode (default safe)
SCALP_INITIAL_CAPITAL_USD=100           # Starting budget for scalp
SCALP_POSITION_SIZE_USD=5              # USD per scalp trade
SCALP_GAMES=cs2,dota2,lol              # Comma-separated game feeds to enable

# LoL Esports Feed
SCALP_LOL_API_KEY=                      # LoL Esports API gateway key (public default baked in; override for rotation)
SCALP_LOL_POLL_INTERVAL_MS=5000        # Live stats polling interval (5s)
SCALP_LOL_DISCOVERY_INTERVAL_MS=30000  # Match discovery interval (30s)
