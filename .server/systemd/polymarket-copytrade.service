[Unit]
Description=Polymarket Copy Trade Stack
After=docker.service
Wants=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/polymarket-copytrade
Environment="DOCKER_HOST=unix:///run/user/%U/docker.sock"
ExecStart=/usr/bin/docker compose -f docker-compose.ghcr.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.ghcr.yml down
Restart=on-failure
RestartSec=15s
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target
