{
  "name": "poly-shadow",
  "version": "0.2.0",
  "private": true,
  "description": "Poly-Shadow: independent READ-ONLY Polymarket trade-discovery shadow. No orders, no signing, no keys, no capital. Forked from mantotan/polymarket-copy-trade (MIT) as architectural reference; see docs/shadow/.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/shadow/main.ts",
    "safety": "node scripts/static-safety.mjs",
    "metrics": "node scripts/multisource-metrics.mjs",
    "compare": "tsx src/compare/stage1-cli.ts",
    "dashboard": "tsx src/compare/dashboard.ts",
    "compare:v1-history": "tsx src/compare/cli.ts",
    "stage1:monitor": "node --max-old-space-size=192 --import tsx src/compare/live-monitor-cli.ts"
  },
  "license": "MIT",
  "dependencies": {
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
