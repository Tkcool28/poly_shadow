generator client {
  provider = "prisma-client"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Trader (discovered wallet) ───

model Trader {
  id              String         @id @default(cuid())
  proxyWallet     String         @unique
  userName        String?
  profileImage    String?
  xUsername       String?
  verifiedBadge   Boolean        @default(false)
  source          TraderSource   @default(LEADERBOARD)
  isMonitored     Boolean        @default(false)

  // Backfill state
  backfillStatus    BackfillStatus @default(PENDING)
  backfillLockedAt  DateTime?
  backfillStarted   DateTime?
  backfillCompleted DateTime?
  backfillRetries   Int            @default(0)
  backfillError     String?
  lastTradeSync     DateTime?
  lastPositionSync  DateTime?

  // Leaderboard snapshot
  leaderboardPnl  Float?
  leaderboardVol  Float?
  leaderboardRank Int?

  // Pre-screen results
  screenPositionCount Int?
  screenWinRate       Float?
  screenRoi           Float?
  screenedAt          DateTime?

  // Relationships
  trades           Trade[]
  positions        Position[]
  closedPositions  ClosedPosition[]
  activities       Activity[]
  scores           TraderScore[]
  scoreHistory     TraderScoreHistory[]
  categoryScores   CategoryScore[]
  followAllocation FollowAllocation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([backfillStatus])
  @@index([backfillStatus, screenedAt])
  @@index([backfillStatus, backfillCompleted])
  @@index([isMonitored])
  @@index([leaderboardPnl(sort: Desc)])
}

enum TraderSource {
  LEADERBOARD
  MANUAL
}

enum BackfillStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  PERMANENTLY_FAILED
  SCREENED_OUT
}

// ─── Market (cached from Gamma API) ───

model Market {
  id            String  @id
  conditionId   String  @unique
  question      String
  slug          String
  category      String?
  outcomes      String  // JSON array e.g. '["Yes","No"]'
  outcomePrices String? // JSON array of current prices
  endDate       DateTime?
  closed        Boolean @default(false)
  active        Boolean @default(true)
  volume        Float?
  liquidity     Float?
  image         String?
  icon          String?
  eventSlug     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([slug])
}

// ─── Trade ───

model Trade {
  id              String @id @default(cuid())
  proxyWallet     String
  side            String // BUY or SELL
  asset           String
  conditionId     String
  size            Float
  price           Float
  timestamp       Int
  outcome         String
  outcomeIndex    Int?
  transactionHash String
  title           String?
  eventSlug       String?
  usdValue        Float? // size * price

  trader Trader @relation(fields: [proxyWallet], references: [proxyWallet])

  createdAt DateTime @default(now())

  @@unique([transactionHash, proxyWallet, asset, side, size, price])
  @@index([proxyWallet, timestamp(sort: Desc)])
  @@index([conditionId])
  @@index([timestamp(sort: Desc)])
}

// ─── Position (latest snapshot, upserted) ───

model Position {
  id           String @id @default(cuid())
  proxyWallet  String
  asset        String
  conditionId  String
  size         Float
  avgPrice     Float
  initialValue Float?
  currentValue Float?
  cashPnl      Float?
  percentPnl   Float?
  realizedPnl  Float?
  curPrice     Float?
  outcome      String
  outcomeIndex Int
  title        String?
  eventSlug    String?
  endDate      DateTime?
  snapshotAt   DateTime @default(now())

  trader Trader @relation(fields: [proxyWallet], references: [proxyWallet])

  @@unique([proxyWallet, asset])
  @@index([proxyWallet])
  @@index([conditionId])
}

// ─── ClosedPosition ───

model ClosedPosition {
  id           String @id @default(cuid())
  proxyWallet  String
  asset        String
  conditionId  String
  avgPrice     Float
  totalBought  Float
  realizedPnl  Float
  curPrice     Float
  timestamp    Int
  outcome      String
  outcomeIndex Int?
  title        String?
  eventSlug    String?
  endDate      DateTime?

  trader Trader @relation(fields: [proxyWallet], references: [proxyWallet])

  @@unique([proxyWallet, asset, conditionId])
  @@index([proxyWallet])
  @@index([conditionId])
}

// ─── Activity ───

model Activity {
  id              String @id @default(cuid())
  proxyWallet     String
  timestamp       Int
  conditionId     String
  type            String // TRADE, SPLIT, MERGE, REDEEM, REWARD, etc.
  size            Float
  usdcSize        Float
  transactionHash String
  price           Float?
  asset           String?
  side            String?
  outcomeIndex    Int?
  title           String?
  eventSlug       String?

  trader Trader @relation(fields: [proxyWallet], references: [proxyWallet])

  @@unique([transactionHash, proxyWallet, conditionId, type, timestamp])
  @@index([proxyWallet, timestamp(sort: Desc)])
  @@index([type])
}

// ─── TraderScore (latest per trader) ───

model TraderScore {
  id          String @id @default(cuid())
  proxyWallet String @unique

  // Profitability
  totalPnl          Float
  realizedPnl       Float
  unrealizedPnl     Float
  roi               Float
  avgProfitPerTrade Float

  // Consistency
  winRate       Float
  maxWinStreak  Int
  maxLossStreak Int
  returnStdDev  Float
  maxDrawdown   Float

  // Activity
  totalTrades     Int
  totalMarkets    Int
  avgPositionSize Float
  avgHoldDuration Float?
  tradeFrequency  Float
  activeDays      Int

  // Risk
  avgRelativePositionSize Float
  concentrationScore      Float

  // Recency
  recentPnl30d     Float
  recentWinRate30d Float
  trendDirection   Float

  // Composite
  compositeScore Float
  rank           Int?

  trader Trader @relation(fields: [proxyWallet], references: [proxyWallet])

  calculatedAt DateTime @default(now())

  @@index([compositeScore(sort: Desc)])
  @@index([calculatedAt(sort: Desc)])
}

// ─── TraderScoreHistory (append-only, capped at 30 per trader) ───

model TraderScoreHistory {
  id             String @id @default(cuid())
  proxyWallet    String
  compositeScore Float
  totalPnl       Float
  winRate        Float
  rank           Int?

  trader Trader @relation(fields: [proxyWallet], references: [proxyWallet])

  calculatedAt DateTime @default(now())

  @@index([proxyWallet, calculatedAt(sort: Desc)])
}

// ─── CategoryScore ───

model CategoryScore {
  id                  String @id @default(cuid())
  proxyWallet         String
  category            String
  pnl                 Float
  winRate             Float
  totalTrades         Int
  avgReturn           Float
  specializationScore Float

  trader Trader @relation(fields: [proxyWallet], references: [proxyWallet])

  calculatedAt DateTime @default(now())

  @@unique([proxyWallet, category, calculatedAt])
  @@index([proxyWallet])
  @@index([category])
}

// ─── FollowAllocation (per-trader capital allocation) ───

model FollowAllocation {
  id                   String    @id @default(cuid())
  proxyWallet          String    @unique
  trader               Trader    @relation(fields: [proxyWallet], references: [proxyWallet])

  // Capital management (all USD)
  initialCapital       Float     // User-set starting budget
  currentCapital       Float     // Available capital (adjusted by realized P&L)
  deployedCapital      Float     @default(0) // Currently in open positions

  // Cached trader portfolio value (from getValue API)
  traderPortfolioValue Float?
  portfolioValueAt     DateTime?

  // Per-allocation sizing overrides (null = use global env defaults)
  copyTradePercent          Float?  // Override COPY_TRADE_PERCENT (e.g. 0.10 = 10%)
  maxPositionUsd            Float?  // Override MAX_POSITION_USD (per-trade cap)
  maxPredictionPositionUsd  Float?  // Override MAX_PREDICTION_POSITION_USD (per-tokenId cap)

  // State
  isActive             Boolean   @default(true)
  isPaper              Boolean   @default(false) // true = paper trading, no real orders

  copyTrades           CopyTrade[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([isActive])
  @@index([isActive, updatedAt(sort: Desc)])
}

// ─── DetectedTrade (logged by trade monitor) ───

model DetectedTrade {
  id              String @id @default(cuid())
  proxyWallet     String
  userName        String?
  side            String
  conditionId     String
  asset           String
  size            Float
  price           Float
  outcome         String
  title           String?
  eventSlug       String?
  transactionHash String
  timestamp       Int
  compositeScore  Float?

  detectedAt      DateTime @default(now())
  detectionSource String?  // "WS", "CHAIN", "LIVE_POLL", "POLL"

  copyTrade CopyTrade?

  @@unique([transactionHash, proxyWallet, asset])
  @@index([detectedAt(sort: Desc)])
  @@index([proxyWallet])
  @@index([proxyWallet, detectedAt(sort: Desc)])
  @@index([conditionId])
}

// ─── CopyTrade (executed copy of a detected trade) ───

model CopyTrade {
  id              String    @id @default(cuid())
  detectedTradeId String    @unique
  detectedTrade   DetectedTrade @relation(fields: [detectedTradeId], references: [id])
  orderId         String?
  tokenId         String
  side            String
  requestedAmount Float
  requestedPrice  Float
  filledPrice     Float?
  filledSize      Float?
  slippageBps     Float?
  status             String    // PENDING, FILLED, FAILED, SKIPPED, POOLED, SETTLED
  failReason         String?
  latencyMs          Int?
  isPaper            Boolean   @default(false) // derived from allocation at creation
  estimatedFee       Float?                    // paper trades: estimated Polymarket fee in USD
  followAllocationId String?
  followAllocation   FollowAllocation? @relation(fields: [followAllocationId], references: [id])
  createdAt          DateTime  @default(now())
  filledAt           DateTime?
  settlementPrice    Float?
  settlementValue    Float?
  settlementPnl      Float?
  settledAt          DateTime?
  claimedAt          DateTime?               // Set after on-chain CTF redemption succeeds

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([tokenId])
  @@index([followAllocationId])
  @@index([isPaper])
  @@index([tokenId, followAllocationId, isPaper, status])  // settlement + getHeldShares
  @@index([status, side, createdAt])                        // daily spend check
  @@index([status, settlementPrice, isPaper])               // unclaimed sweep lookup
}

// ─── ArbStrategyConfig (per-strategy runtime config — replaces per-strategy env vars) ───

model ArbStrategyConfig {
  strategy          String   @id           // "standard", "contrarian", "contrarian-every3", etc.
  enabled           Boolean  @default(false)
  assets            String?                 // comma-sep override, e.g. "sol,eth" (null = use global ARB_ASSETS)
  durations         String?                 // comma-sep override, e.g. "5m" (null = use global ARB_MARKET_TYPES)
  positionSizeUsd   Float                   // per-trade position size in USD
  maxEntryPrice     Float                   // max price to pay per share (standard: 0.99, contrarian: 0.10)
  initialCapitalUsd Float                   // starting capital when creating ArbCapital

  // Composable strategy variant params (all optional, can combine)
  everyNth          Int?                    // enter every Nth candle (null = every candle)
  cooldownLosses    Int?                    // trigger cooldown after N consecutive losses
  cooldownSkip      Int?                    // skip N candles after cooldown triggers
  antiMartingale    Boolean  @default(false) // halve position after loss, restore after win
  minConfidence     Float?                  // per-strategy confidence threshold (null = use global ARB_MIN_CONFIDENCE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── ArbCapital (arb worker's independent capital ledger) ───

model ArbCapital {
  id              String   @id @default(cuid())
  initialCapital  Float                 // Set from ARB_INITIAL_CAPITAL_USD
  currentCapital  Float                 // Available to deploy (auto-recycles on settlement)
  deployedCapital Float    @default(0)  // Locked in open arb positions
  isPaper         Boolean  @default(true)
  strategy        String   @default("standard") // "standard" or "contrarian"
  totalPnl        Float    @default(0)  // Running cumulative P&L
  totalCycles     Int      @default(0)  // Total completed cycles
  totalWins       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([isPaper, strategy]) // One record per (mode, strategy)
}

// ─── ArbCycle (per-candle arb cycle tracking) ───

enum ArbCycleStatus {
  PENDING
  WATCHING
  ENTERED
  WON
  LOST
  STOPPED
  SKIPPED
  FAILED
}

model ArbCycle {
  id            String  @id @default(cuid())

  // Candle identification
  marketType    String  // "5m", "15m", "1h"
  candleStartMs BigInt  // Unix ms of candle start
  slug          String  // e.g. "btc-updown-5m-1709300100"
  conditionId   String?

  // BTC price tracking
  btcOpenPrice  Float   // BTC price at candle open
  btcEntryPrice Float?  // BTC price at entry decision
  btcClosePrice Float?  // BTC price at candle close

  // Direction
  direction     String? // "UP", "DOWN", or null if skipped

  // Entry
  tokenId       String? // CLOB token ID of the outcome bought
  entryPrice    Float?  // Price paid per share
  entryShares   Float?  // Number of shares bought
  entryAmountUsd Float? // Total USD spent
  orderId       String? // CLOB order ID

  // Confidence scoring
  confidenceScore    Float?    // 0.0-1.0 composite score at entry
  confidenceSignals  String?   // JSON: individual signal values for analysis

  // Market pricing
  oppositePrice       Float?  // Polymarket losing-side token price at evaluation time

  // Settlement
  settlementPrice     Float?  // 1.0 (win) or 0.0 (loss)
  pnl                 Float?  // Net P&L for this cycle
  estimatedFee        Float?  // Estimated Polymarket fee
  settlementStartedAt DateTime? // When background settlement first attempted this cycle

  status        ArbCycleStatus @default(PENDING)
  failReason    String?
  isPaper       Boolean @default(true)
  strategy      String  @default("standard") // "standard" or "contrarian"

  // Timing
  enteredAt     DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([marketType, candleStartMs, isPaper, strategy]) // One cycle per candle per engine per strategy
  @@index([status])
  @@index([marketType, candleStartMs])
  @@index([createdAt(sort: Desc)])
  @@index([isPaper, status])
  @@index([isPaper, strategy, status])
}

// ─── SystemHealth ───

model SystemHealth {
  id             String @id @default(cuid())
  jobName        String @unique
  lastRunAt      DateTime
  lastRunDuration Int // milliseconds
  lastRunResult  String // success, partial, error
  processedCount Int    @default(0)
  errorMessage   String?

  updatedAt DateTime @updatedAt
}

// ─── Scalp Worker (in-play esports/tennis trading) ───

enum ScalpCycleStatus {
  ENTERED
  SOLD
  SETTLED_WON
  SETTLED_LOST
  SKIPPED
  FAILED
  CANCELLED
}

model ScalpCycle {
  id               String   @id @default(cuid())
  game             String   // "cs2" | "dota2" | "lol" | "val" | "atp" | "wta"
  matchId          String   // external match ID from game API or bot-signal
  slug             String   // Polymarket market slug
  conditionId      String?
  marketQuestion   String?
  outcomeLabel     String?  // "MOUZ", "Astralis", etc.
  tokenId          String?
  eventType        String   // "map_win" | "series_end" | "bot_signal"
  eventSequence    Int      @default(0) // map number (1, 2, 3) or 0 for series_end
  eventDetail      String?  // JSON: series score, map score, etc.
  signalSource     String?  // "bot" | "game_api" | "both"
  signalConfidence String?  // "LOW" | "MEDIUM" | "HIGH"

  // Entry
  entryPrice       Float?
  entryShares      Float?
  entryAmountUsd   Float?
  entryOrderId     String?
  entryOrderType   String?  // "FAK" | "GTC"
  entryLatencyMs   Int?     // event-detected → order-placed

  // Exit
  exitPrice        Float?
  exitShares       Float?
  exitOrderId      String?
  exitMethod       String?  // "convergence_sell" | "settlement" | "stop_loss"

  // P&L
  pnl              Float?
  estimatedEdge    Float?   // expected edge at entry time

  status           ScalpCycleStatus @default(ENTERED)
  failReason       String?
  isPaper          Boolean  @default(true)
  enteredAt        DateTime?
  exitedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([matchId, game, tokenId, eventType, eventSequence, isPaper])
  @@index([status])
  @@index([isPaper, status])
}

model ScalpCapital {
  id              String   @id @default(cuid())
  initialCapital  Float
  currentCapital  Float
  deployedCapital Float    @default(0)
  isPaper         Boolean  @default(true)
  totalPnl        Float    @default(0)
  totalCycles     Int      @default(0)
  totalWins       Int      @default(0)
  dailyLossUsd    Float    @default(0)
  dailyLossResetAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([isPaper])
}

model ScalpMarketWatch {
  id              String    @id @default(cuid())
  game            String    // "cs2" | "dota2" | "lol" | "val" | "atp" | "wta"
  slug            String    @unique
  conditionId     String
  question        String
  outcomes        String    // JSON: ["MOUZ", "Astralis"]
  clobTokenIds    String    // JSON: ["token1", "token2"]
  negRisk         Boolean   @default(false)
  tickSize        Float     @default(0.01)
  orderMinSize    Float     @default(5)
  liquidity       Float?
  eventSlug       String?
  endDate         DateTime?
  isActive        Boolean   @default(true)
  marketType      String    @default("series") // "series" | "map" | "handicap" | "total"
  homeTeam        String?   // normalized: trimmed, lowercase
  awayTeam        String?   // normalized: trimmed, lowercase
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([game, isActive, marketType])
  @@index([homeTeam, awayTeam])
}
