{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "research/v2-cursor-v1/**/*.ts",
    "research/v2-cursor-v1/**/*.mts",
    "research/v2-corrected-v1-1/**/*.ts",
    "research/v2-corrected-v1-1/**/*.mts"
  ]
}
